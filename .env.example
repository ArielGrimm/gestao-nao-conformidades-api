# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# NUNCA faça commit do arquivo .env (ele já está no .gitignore).

PORT=3000

# "memory" = dados em memória (somem ao reiniciar; bom para desenvolver e testar)
# "supabase" = dados persistidos no banco do Supabase
REPOSITORY=memory

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-chave-aqui
